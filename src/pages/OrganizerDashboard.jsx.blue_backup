import { useEffect, useMemo, useState } from "react";
import { Link } from "react-router-dom";
import Navbar from "../components/Navbar";
import "../styles.css";

function OrganizerDashboard() {
  const user = JSON.parse(
    localStorage.getItem("ticketflowUser") || "{}"
  );

  const organizerId = user.id;

  const [bookings, setBookings] = useState([]);
  const [events, setEvents] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [selectedBooking, setSelectedBooking] = useState(null);

  // =========================================================
  // LOAD ORGANIZER DATA
  // =========================================================

  const loadOrganizerData = async () => {
    try {
      setLoading(true);
      setError("");
      const token = localStorage.getItem("ticketflowToken");

if (!token) {
  throw new Error("Login token missing. Please log in again.");
}

      if (!organizerId) {
        throw new Error(
          "Organizer information not found. Please login again."
        );
      }


const [bookingsResponse, eventsResponse] = await Promise.all([
  fetch(
    `http://localhost:8080/api/bookings/organizer/${organizerId}`,
    {
      headers: {
        Authorization: `Bearer ${token}`,
      },
    }
  ),
  fetch(
    `http://localhost:8080/api/events/organizer/${organizerId}`,
    {
      headers: {
        Authorization: `Bearer ${token}`,
      },
    }
  ),
]);


      if (!bookingsResponse.ok) {
        throw new Error(
          "Failed to load organizer bookings."
        );
      }

      if (!eventsResponse.ok) {
        throw new Error(
          "Failed to load organizer events."
        );
      }

      const bookingsData =
        await bookingsResponse.json();

      const eventsData =
        await eventsResponse.json();

      setBookings(
        Array.isArray(bookingsData)
          ? bookingsData
          : []
      );

      setEvents(
        Array.isArray(eventsData)
          ? eventsData
          : []
      );
    } catch (err) {
      console.error(
        "Organizer dashboard error:",
        err
      );

      setError(
        err.message ||
          "Unable to load organizer dashboard."
      );
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    loadOrganizerData();
  }, [organizerId]);

  // =========================================================
  // STATISTICS
  // =========================================================

  const statistics = useMemo(() => {
    const confirmedBookings = bookings.filter(
      (booking) =>
        booking.bookingStatus === "CONFIRMED"
    );

    const ticketsSold =
      confirmedBookings.reduce(
        (total, booking) =>
          total +
          (Array.isArray(booking.seats)
            ? booking.seats.length
            : 0),
        0
      );

    const revenue =
      confirmedBookings.reduce(
        (total, booking) =>
          total +
          Number(
            booking.totalAmount || 0
          ),
        0
      );

    return {
      eventCount: events.length,
      ticketsSold,
      attendees: confirmedBookings.length,
      revenue,
    };
  }, [bookings, events]);

  // =========================================================
  // EVENT STATISTICS
  // =========================================================

  const eventStatistics = useMemo(() => {
    return events.map((event) => {
      const eventBookings =
        bookings.filter(
          (booking) =>
            Number(booking.eventId) ===
            Number(event.id)
        );

      const confirmedBookings =
        eventBookings.filter(
          (booking) =>
            booking.bookingStatus ===
            "CONFIRMED"
        );

      const ticketsSold =
        confirmedBookings.reduce(
          (total, booking) =>
            total +
            (Array.isArray(booking.seats)
              ? booking.seats.length
              : 0),
          0
        );

      const revenue =
        confirmedBookings.reduce(
          (total, booking) =>
            total +
            Number(
              booking.totalAmount || 0
            ),
          0
        );

      return {
        ...event,
        bookingCount:
          eventBookings.length,
        ticketsSold,
        revenue,
      };
    });
  }, [events, bookings]);

  // =========================================================
  // FORMATTERS
  // =========================================================

  const formatCurrency = (amount) => {
    return `₹${Number(
      amount || 0
    ).toLocaleString("en-IN", {
      maximumFractionDigits: 2,
    })}`;
  };

  const formatDate = (date) => {
    if (!date) return "-";

    const parsedDate = new Date(date);

    if (Number.isNaN(parsedDate.getTime())) {
      return date;
    }

    return parsedDate.toLocaleDateString(
      "en-IN",
      {
        day: "2-digit",
        month: "short",
        year: "numeric",
      }
    );
  };

  const formatTime = (time) => {
    if (!time) return "-";

    return String(time).substring(0, 5);
  };

  const getStatusClass = (status) => {
    if (status === "CONFIRMED") {
      return "organizer-status confirmed";
    }

    if (status === "PAYMENT_PENDING") {
      return "organizer-status pending";
    }

    if (
      status === "CANCELLED" ||
      status === "FAILED"
    ) {
      return "organizer-status cancelled";
    }

    return "organizer-status";
  };

  // =========================================================
  // LOADING
  // =========================================================

  if (loading) {
    return (
      <div className="dashboard-page">
        <div className="dashboard-container">
          <div className="dashboard-header">
            <div>
              <span className="section-label">
                ORGANIZER DASHBOARD
              </span>

              <h1>
                Welcome,{" "}
                {user.firstName ||
                  user.name ||
                  "Organizer"}
                !
              </h1>

              <p>
                Loading your organizer data...
              </p>
            </div>

            <Link
              to="/"
              className="dashboard-home"
            >
              ← Home
            </Link>
          </div>

          <div
            style={{
              background: "#ffffff",
              borderRadius: "16px",
              padding: "50px",
              textAlign: "center",
              boxShadow:
                "0 10px 30px rgba(15, 23, 42, 0.08)",
            }}
          >
            <div
              style={{
                fontSize: "42px",
                marginBottom: "15px",
              }}
            >
              ⏳
            </div>

            <h2>Loading Dashboard</h2>

            <p
              style={{
                color: "#64748b",
              }}
            >
              Fetching your events and
              bookings...
            </p>
          </div>
        </div>
      </div>
    );
  }

  // =========================================================
  // ERROR
  // =========================================================

  if (error) {
    return (
      <div className="dashboard-page">
        <div className="dashboard-container">
          <div className="dashboard-header">
            <div>
              <span className="section-label">
                ORGANIZER DASHBOARD
              </span>

              <h1>
                Welcome,{" "}
                {user.firstName ||
                  user.name ||
                  "Organizer"}
                !
              </h1>

              <p>
                Create events, manage venues,
                tickets and attendees.
              </p>
            </div>

            <Link
              to="/"
              className="dashboard-home"
            >
              ← Home
            </Link>
          </div>

          <div
            style={{
              background: "#ffffff",
              borderRadius: "16px",
              padding: "40px",
              textAlign: "center",
              border:
                "1px solid #fecaca",
              boxShadow:
                "0 10px 30px rgba(15, 23, 42, 0.08)",
            }}
          >
            <div
              style={{
                fontSize: "42px",
                marginBottom: "15px",
              }}
            >
              ⚠️
            </div>

            <h2>
              Unable to Load Dashboard
            </h2>

            <p
              style={{
                color: "#dc2626",
                marginBottom: "20px",
              }}
            >
              {error}
            </p>

            <button
              onClick={loadOrganizerData}
              style={{
                border: "none",
                background: "#2563eb",
                color: "#ffffff",
                padding: "12px 22px",
                borderRadius: "10px",
                cursor: "pointer",
                fontWeight: "600",
              }}
            >
              Try Again
            </button>
          </div>
        </div>
      </div>
    );
  }

  // =========================================================
  // MAIN DASHBOARD
  // =========================================================

  return (
    <div className="dashboard-page">
      <Navbar />
      <div className="dashboard-container">

        {/* ================================================= */}
        {/* HEADER */}
        {/* ================================================= */}

        <div className="dashboard-header">
          <div>
            <span className="section-label">
              ORGANIZER DASHBOARD
            </span>

            <h1>
              Welcome,{" "}
              {user.firstName ||
                user.name ||
                "Organizer"}
              !
            </h1>

            <p>
              Create events, manage venues,
              tickets and attendees.
            </p>
          </div>

          <div
            style={{
              display: "flex",
              gap: "10px",
              alignItems: "center",
              flexWrap: "wrap",
            }}
          >
            <button
              onClick={loadOrganizerData}
              style={{
                border:
                  "1px solid #e2e8f0",
                background: "#ffffff",
                color: "#0f172a",
                padding: "10px 16px",
                borderRadius: "10px",
                cursor: "pointer",
                fontWeight: "600",
              }}
            >
              ↻ Refresh
            </button>

            <Link
              to="/"
              className="dashboard-home"
            >
              ← Home
            </Link>
          </div>
        </div>

        {/* ================================================= */}
        {/* STATISTICS */}
        {/* ================================================= */}

        <div className="dashboard-grid">

          <div className="dashboard-stat">
            <span>🎤</span>

            <strong>
              {statistics.eventCount}
            </strong>

            <small>Events</small>
          </div>

          <div className="dashboard-stat">
            <span>🎟️</span>

            <strong>
              {statistics.ticketsSold}
            </strong>

            <small>Tickets Sold</small>
          </div>

          <div className="dashboard-stat">
            <span>👥</span>

            <strong>
              {statistics.attendees}
            </strong>

            <small>Attendees</small>
          </div>

          <div className="dashboard-stat">
            <span>₹</span>

            <strong>
              {formatCurrency(
                statistics.revenue
              )}
            </strong>

            <small>Total Revenue</small>
          </div>

        </div>

        {/* ================================================= */}
        {/* EVENT MANAGEMENT */}
        {/* ================================================= */}

        <div className="dashboard-section">
          <h2>Event Management</h2>

          <div className="dashboard-actions">

            {/* QR GATE CHECK-IN */}
            <Link
              to="/organizer/check-in"
              className="dashboard-action"
              style={{
                textDecoration: "none",
                color: "inherit",
                cursor: "pointer",
                background: "linear-gradient(135deg, rgba(37,99,235,0.06), rgba(37,99,235,0.14))",
                borderColor: "#2563eb",
              }}
            >
              <span>📲</span>

              <strong>
                QR Gate Check-In
              </strong>

              <small style={{ color: "#2563eb", fontWeight: "600" }}>
                Scan tickets at gate
              </small>
            </Link>

            {/* CREATE EVENT */}
            <Link
              to="/organizer/create-event"
              className="dashboard-action"
              style={{
                textDecoration: "none",
                color: "inherit",
                cursor: "pointer",
              }}
            >
              <span>➕</span>

              <strong>
                Create Event
              </strong>

              <small>
                Create a new event
              </small>
            </Link>

            {/* MY EVENTS */}
            <div
              className="dashboard-action"
              onClick={() =>
                document
                  .getElementById(
                    "organizer-events"
                  )
                  ?.scrollIntoView({
                    behavior: "smooth",
                  })
              }
              style={{
                cursor: "pointer",
              }}
            >
              <span>📅</span>

              <strong>
                My Events
              </strong>

              <small>
                Manage your events
              </small>
            </div>

            {/* BOOKINGS */}
            <div
              className="dashboard-action"
              onClick={() =>
                document
                  .getElementById(
                    "organizer-bookings"
                  )
                  ?.scrollIntoView({
                    behavior: "smooth",
                  })
              }
              style={{
                cursor: "pointer",
              }}
            >
              <span>🎟️</span>

              <strong>
                Bookings
              </strong>

              <small>
                View customer bookings
              </small>
            </div>

            {/* STALLS */}
            
<Link
  to="/organizer/stall-applications"
  className="dashboard-action"
  style={{
    textDecoration: "none",
    color: "inherit",
    cursor: "pointer",
  }}
>
  <span>🏪</span>
  <strong>Stalls</strong>
  <small>Review and manage stall applications</small>
</Link>

<Link
  to="/organizer/profile"
  className="dashboard-action"
  style={{
    textDecoration: "none",
    color: "inherit",
    cursor: "pointer",
  }}
>
  <span>👤</span>
  <strong>My Profile</strong>
  <small>Edit personal details & password</small>
</Link>
          </div>
        </div>

        {/* ================================================= */}
        {/* MY EVENTS */}
        {/* ================================================= */}

        <div
          className="dashboard-section"
          id="organizer-events"
          style={{
            marginTop: "30px",
          }}
        >
          <div
            style={{
              display: "flex",
              justifyContent:
                "space-between",
              alignItems: "center",
              gap: "15px",
              marginBottom: "20px",
              flexWrap: "wrap",
            }}
          >
            <div>
              <span className="section-label">
                YOUR EVENTS
              </span>

              <h2
                style={{
                  marginBottom: "5px",
                }}
              >
                My Events
              </h2>

              <p
                style={{
                  margin: 0,
                  color: "#64748b",
                }}
              >
                Events created by you
              </p>
            </div>

            <span
              style={{
                background: "#eff6ff",
                color: "#2563eb",
                padding: "8px 14px",
                borderRadius: "999px",
                fontWeight: "700",
              }}
            >
              {events.length} Event
              {events.length !== 1
                ? "s"
                : ""}
            </span>
          </div>

          {eventStatistics.length === 0 ? (
            <div
              style={{
                background: "#ffffff",
                border:
                  "1px solid #e2e8f0",
                borderRadius: "16px",
                padding: "35px",
                textAlign: "center",
              }}
            >
              <div
                style={{
                  fontSize: "40px",
                  marginBottom: "10px",
                }}
              >
                🎤
              </div>

              <h3>
                No Events Yet
              </h3>

              <p
                style={{
                  color: "#64748b",
                }}
              >
                You have not created any
                events yet.
              </p>

              <Link
                to="/organizer/create-event"
                style={{
                  display: "inline-block",
                  marginTop: "10px",
                  padding:
                    "10px 18px",
                  background:
                    "#2563eb",
                  color: "#ffffff",
                  borderRadius:
                    "10px",
                  textDecoration:
                    "none",
                  fontWeight: "600",
                }}
              >
                + Create Your First Event
              </Link>
            </div>
          ) : (
            <div
              style={{
                display: "grid",
                gridTemplateColumns:
                  "repeat(auto-fit, minmax(280px, 1fr))",
                gap: "20px",
              }}
            >
              {eventStatistics.map(
                (event) => (
                  <div
                    key={event.id}
                    style={{
                      background:
                        "#ffffff",
                      border:
                        "1px solid #e2e8f0",
                      borderRadius:
                        "16px",
                      padding: "22px",
                      boxShadow:
                        "0 8px 24px rgba(15, 23, 42, 0.06)",
                    }}
                  >
                    <div
                      style={{
                        display:
                          "flex",
                        justifyContent:
                          "space-between",
                        gap: "10px",
                        marginBottom:
                          "15px",
                      }}
                    >
                      <span
                        style={{
                          background:
                            "#eff6ff",
                          color:
                            "#2563eb",
                          padding:
                            "6px 10px",
                          borderRadius:
                            "8px",
                          fontSize:
                            "12px",
                          fontWeight:
                            "700",
                        }}
                      >
                        {event.category ||
                          "EVENT"}
                      </span>

                      <span
                        style={{
                          fontSize:
                            "12px",
                          color:
                            "#64748b",
                        }}
                      >
                        #{event.id}
                      </span>
                    </div>

                    <h3
                      style={{
                        margin:
                          "0 0 10px",
                        color:
                          "#0f172a",
                      }}
                    >
                      {event.title}
                    </h3>

                    <p
                      style={{
                        color:
                          "#64748b",
                        fontSize:
                          "14px",
                        marginBottom:
                          "15px",
                      }}
                    >
                      📅{" "}
                      {formatDate(
                        event.eventDate
                      )}
                      <br />

                      🕐{" "}
                      {formatTime(
                        event.startTime
                      )}{" "}
                      -{" "}
                      {formatTime(
                        event.endTime
                      )}
                    </p>

                    <div
                      style={{
                        display:
                          "grid",
                        gridTemplateColumns:
                          "repeat(3, 1fr)",
                        gap: "8px",
                        marginTop:
                          "15px",
                      }}
                    >
                      <div
                        style={{
                          background:
                            "#f8fafc",
                          borderRadius:
                            "10px",
                          padding:
                            "10px",
                          textAlign:
                            "center",
                        }}
                      >
                        <strong>
                          {
                            event.bookingCount
                          }
                        </strong>

                        <small
                          style={{
                            display:
                              "block",
                            color:
                              "#64748b",
                            fontSize:
                              "11px",
                          }}
                        >
                          Bookings
                        </small>
                      </div>

                      <div
                        style={{
                          background:
                            "#f8fafc",
                          borderRadius:
                            "10px",
                          padding:
                            "10px",
                          textAlign:
                            "center",
                        }}
                      >
                        <strong>
                          {
                            event.ticketsSold
                          }
                        </strong>

                        <small
                          style={{
                            display:
                              "block",
                            color:
                              "#64748b",
                            fontSize:
                              "11px",
                          }}
                        >
                          Tickets
                        </small>
                      </div>

                      <div
                        style={{
                          background:
                            "#f8fafc",
                          borderRadius:
                            "10px",
                          padding:
                            "10px",
                          textAlign:
                            "center",
                        }}
                      >
                        <strong
                          style={{
                            fontSize:
                              "13px",
                          }}
                        >
                          {formatCurrency(
                            event.revenue
                          )}
                        </strong>

                        <small
                          style={{
                            display:
                              "block",
                            color:
                              "#64748b",
                            fontSize:
                              "11px",
                          }}
                        >
                          Revenue
                        </small>
                      </div>
                    </div>
                  </div>
                )
              )}
            </div>
          )}
        </div>

        {/* ================================================= */}
        {/* CUSTOMER BOOKINGS */}
        {/* ================================================= */}

        <div
          className="dashboard-section"
          id="organizer-bookings"
          style={{
            marginTop: "30px",
          }}
        >
          <div
            style={{
              display: "flex",
              justifyContent:
                "space-between",
              alignItems: "center",
              gap: "15px",
              marginBottom: "20px",
              flexWrap: "wrap",
            }}
          >
            <div>
              <span className="section-label">
                CUSTOMER BOOKINGS
              </span>

              <h2
                style={{
                  marginBottom: "5px",
                }}
              >
                Booking Management
              </h2>

              <p
                style={{
                  margin: 0,
                  color: "#64748b",
                }}
              >
                View customer tickets,
                seats and food orders.
              </p>
            </div>

            <span
              style={{
                background: "#f0fdf4",
                color: "#16a34a",
                padding: "8px 14px",
                borderRadius:
                  "999px",
                fontWeight: "700",
              }}
            >
              {bookings.length} Booking
              {bookings.length !== 1
                ? "s"
                : ""}
            </span>
          </div>

          {bookings.length === 0 ? (
            <div
              style={{
                background: "#ffffff",
                border:
                  "1px solid #e2e8f0",
                borderRadius: "16px",
                padding: "35px",
                textAlign: "center",
              }}
            >
              <div
                style={{
                  fontSize: "40px",
                  marginBottom: "10px",
                }}
              >
                🎟️
              </div>

              <h3>
                No Bookings Yet
              </h3>

              <p
                style={{
                  color: "#64748b",
                }}
              >
                Customer bookings will
                appear here.
              </p>
            </div>
          ) : (
            <div
              style={{
                display: "flex",
                flexDirection:
                  "column",
                gap: "15px",
              }}
            >
              {bookings.map(
                (booking) => (
                  <div
                    key={
                      booking.bookingId
                    }
                    style={{
                      background:
                        "#ffffff",
                      border:
                        "1px solid #e2e8f0",
                      borderRadius:
                        "16px",
                      padding: "20px",
                      boxShadow:
                        "0 6px 20px rgba(15, 23, 42, 0.05)",
                    }}
                  >
                    <div
                      style={{
                        display:
                          "flex",
                        justifyContent:
                          "space-between",
                        alignItems:
                          "flex-start",
                        gap: "15px",
                        flexWrap:
                          "wrap",
                      }}
                    >
                      <div>
                        <h3
                          style={{
                            margin:
                              "0 0 6px",
                          }}
                        >
                          {booking.eventTitle ||
                            "Event"}
                        </h3>

                        <p
                          style={{
                            margin:
                              "0 0 5px",
                            color:
                              "#64748b",
                            fontSize:
                              "14px",
                          }}
                        >
                          Booking:{" "}
                          <strong>
                            {
                              booking.bookingReference
                            }
                          </strong>
                        </p>

                        <p
                          style={{
                            margin: 0,
                            color:
                              "#64748b",
                            fontSize:
                              "14px",
                          }}
                        >
                          📅{" "}
                          {formatDate(
                            booking.eventDate
                          )}{" "}
                          •{" "}
                          {formatTime(
                            booking.startTime
                          )}{" "}
                          -{" "}
                          {formatTime(
                            booking.endTime
                          )}
                        </p>
                      </div>

                      <div
                        style={{
                          display:
                            "flex",
                          alignItems:
                            "center",
                          gap: "10px",
                          flexWrap:
                            "wrap",
                        }}
                      >
                        <span
                          className={getStatusClass(
                            booking.bookingStatus
                          )}
                        >
                          {
                            booking.bookingStatus
                          }
                        </span>

                        <strong
                          style={{
                            fontSize:
                              "18px",
                            color:
                              "#0f172a",
                          }}
                        >
                          {formatCurrency(
                            booking.totalAmount
                          )}
                        </strong>
                      </div>
                    </div>

                    {/* CUSTOMER INFO */}
                    <div
                      style={{
                        display:
                          "grid",
                        gridTemplateColumns:
                          "repeat(auto-fit, minmax(180px, 1fr))",
                        gap: "10px",
                        marginTop:
                          "18px",
                      }}
                    >
                      <div
                        style={{
                          background:
                            "#f8fafc",
                          borderRadius:
                            "10px",
                          padding:
                            "12px",
                        }}
                      >
                        <small
                          style={{
                            color:
                              "#64748b",
                          }}
                        >
                          Customer
                        </small>

                        <div
                          style={{
                            fontWeight:
                              "700",
                            marginTop:
                              "4px",
                          }}
                        >
                          {booking.customerName ||
                            "Customer"}
                        </div>
                      </div>

                      <div
                        style={{
                          background:
                            "#f8fafc",
                          borderRadius:
                            "10px",
                          padding:
                            "12px",
                        }}
                      >
                        <small
                          style={{
                            color:
                              "#64748b",
                          }}
                        >
                          Email
                        </small>

                        <div
                          style={{
                            fontWeight:
                              "600",
                            marginTop:
                              "4px",
                            wordBreak:
                              "break-word",
                          }}
                        >
                          {
                            booking.customerEmail
                          }
                        </div>
                      </div>

                      <div
                        style={{
                          background:
                            "#f8fafc",
                          borderRadius:
                            "10px",
                          padding:
                            "12px",
                        }}
                      >
                        <small
                          style={{
                            color:
                              "#64748b",
                          }}
                        >
                          Phone
                        </small>

                        <div
                          style={{
                            fontWeight:
                              "600",
                            marginTop:
                              "4px",
                          }}
                        >
                          {booking.customerPhone ||
                            "-"}
                        </div>
                      </div>

                      <div
                        style={{
                          background:
                            "#f8fafc",
                          borderRadius:
                            "10px",
                          padding:
                            "12px",
                        }}
                      >
                        <small
                          style={{
                            color:
                              "#64748b",
                          }}
                        >
                          Tickets
                        </small>

                        <div
                          style={{
                            fontWeight:
                              "700",
                            marginTop:
                              "4px",
                          }}
                        >
                          {Array.isArray(
                            booking.seats
                          )
                            ? booking.seats
                                .length
                            : 0}
                        </div>
                      </div>
                    </div>

                    {/* BOTTOM */}
                    <div
                      style={{
                        display:
                          "flex",
                        justifyContent:
                          "space-between",
                        alignItems:
                          "center",
                        gap: "15px",
                        marginTop:
                          "18px",
                        flexWrap:
                          "wrap",
                      }}
                    >
                      <div
                        style={{
                          color:
                            "#64748b",
                          fontSize:
                            "14px",
                        }}
                      >
                        🎟️{" "}
                        {booking.ticketNumber ||
                          "Ticket not generated yet"}
                      </div>

                      <button
                        onClick={() =>
                          setSelectedBooking(
                            booking
                          )
                        }
                        style={{
                          border:
                            "none",
                          background:
                            "#2563eb",
                          color:
                            "#ffffff",
                          padding:
                            "10px 18px",
                          borderRadius:
                            "9px",
                          cursor:
                            "pointer",
                          fontWeight:
                            "600",
                        }}
                      >
                        View Details →
                      </button>
                    </div>
                  </div>
                )
              )}
            </div>
          )}
        </div>

        {/* ================================================= */}
        {/* BOOKING DETAIL MODAL */}
        {/* ================================================= */}

        {selectedBooking && (
          <div
            onClick={() =>
              setSelectedBooking(null)
            }
            style={{
              position: "fixed",
              inset: 0,
              background:
                "rgba(15, 23, 42, 0.65)",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              padding: "20px",
              zIndex: 1000,
            }}
          >
            <div
              onClick={(event) =>
                event.stopPropagation()
              }
              style={{
                width:
                  "min(850px, 100%)",
                maxHeight: "90vh",
                overflowY: "auto",
                background:
                  "#ffffff",
                borderRadius:
                  "20px",
                padding: "28px",
                boxShadow:
                  "0 25px 60px rgba(0, 0, 0, 0.25)",
              }}
            >
              {/* MODAL HEADER */}
              <div
                style={{
                  display:
                    "flex",
                  justifyContent:
                    "space-between",
                  alignItems:
                    "flex-start",
                  gap: "15px",
                  marginBottom:
                    "20px",
                }}
              >
                <div>
                  <span className="section-label">
                    BOOKING DETAILS
                  </span>

                  <h2
                    style={{
                      margin:
                        "5px 0",
                    }}
                  >
                    {
                      selectedBooking.eventTitle
                    }
                  </h2>

                  <p
                    style={{
                      margin: 0,
                      color:
                        "#64748b",
                    }}
                  >
                    {
                      selectedBooking.bookingReference
                    }
                  </p>
                </div>

                <button
                  onClick={() =>
                    setSelectedBooking(
                      null
                    )
                  }
                  style={{
                    border: "none",
                    background:
                      "#f1f5f9",
                    width: "38px",
                    height: "38px",
                    borderRadius:
                      "50%",
                    cursor:
                      "pointer",
                    fontSize:
                      "20px",
                  }}
                >
                  ×
                </button>
              </div>

              {/* CUSTOMER */}
              <div
                style={{
                  background:
                    "#f8fafc",
                  borderRadius:
                    "14px",
                  padding: "18px",
                  marginBottom:
                    "18px",
                }}
              >
                <h3>
                  Customer
                </h3>

                <p>
                  <strong>
                    Name:
                  </strong>{" "}
                  {
                    selectedBooking.customerName
                  }
                </p>

                <p>
                  <strong>
                    Email:
                  </strong>{" "}
                  {
                    selectedBooking.customerEmail
                  }
                </p>

                <p>
                  <strong>
                    Phone:
                  </strong>{" "}
                  {
                    selectedBooking.customerPhone ||
                    "-"
                  }
                </p>
              </div>

              {/* SEATS */}
              <div
                style={{
                  marginBottom:
                    "18px",
                }}
              >
                <h3>
                  🎟️ Seats
                </h3>

                {Array.isArray(
                  selectedBooking.seats
                ) &&
                selectedBooking.seats
                  .length > 0 ? (
                  <div
                    style={{
                      display:
                        "flex",
                      flexWrap:
                        "wrap",
                      gap: "10px",
                    }}
                  >
                    {selectedBooking.seats.map(
                      (
                        seat,
                        index
                      ) => (
                        <div
                          key={`${seat.eventSeatId}-${index}`}
                          style={{
                            background:
                              "#eff6ff",
                            border:
                              "1px solid #bfdbfe",
                            borderRadius:
                              "10px",
                            padding:
                              "10px 14px",
                          }}
                        >
                          <strong>
                            {
                              seat.seatRow
                            }
                            {
                              seat.seatNumber
                            }
                          </strong>

                          <div
                            style={{
                              fontSize:
                                "12px",
                              color:
                                "#64748b",
                            }}
                          >
                            {
                              seat.seatType
                            }{" "}
                            •{" "}
                            {formatCurrency(
                              seat.price
                            )}
                          </div>
                        </div>
                      )
                    )}
                  </div>
                ) : (
                  <p
                    style={{
                      color:
                        "#64748b",
                    }}
                  >
                    No seat information.
                  </p>
                )}
              </div>

              {/* FOOD */}
              <div
                style={{
                  marginBottom:
                    "18px",
                }}
              >
                <h3>
                  🍔 Food Orders
                </h3>

                {Array.isArray(
                  selectedBooking.foodItems
                ) &&
                selectedBooking.foodItems
                  .length > 0 ? (
                  <div
                    style={{
                      display:
                        "flex",
                      flexDirection:
                        "column",
                      gap: "10px",
                    }}
                  >
                    {selectedBooking.foodItems.map(
                      (
                        food,
                        index
                      ) => (
                        <div
                          key={`${food.stallItemId}-${index}`}
                          style={{
                            display:
                              "flex",
                            justifyContent:
                              "space-between",
                            alignItems:
                              "center",
                            gap: "15px",
                            background:
                              "#f8fafc",
                            borderRadius:
                              "10px",
                            padding:
                              "12px 15px",
                          }}
                        >
                          <div>
                            <strong>
                              {
                                food.itemName
                              }
                            </strong>

                            <div
                              style={{
                                color:
                                  "#64748b",
                                fontSize:
                                  "13px",
                              }}
                            >
                              {
                                food.stallName ||
                                "Stall"
                              }{" "}
                              • Qty{" "}
                              {
                                food.quantity
                              }
                            </div>
                          </div>

                          <strong>
                            {formatCurrency(
                              food.totalPrice
                            )}
                          </strong>
                        </div>
                      )
                    )}
                  </div>
                ) : (
                  <p
                    style={{
                      color:
                        "#64748b",
                    }}
                  >
                    No food items ordered.
                  </p>
                )}
              </div>

              {/* PAYMENT */}
              <div
                style={{
                  background:
                    "#f8fafc",
                  borderRadius:
                    "14px",
                  padding: "18px",
                }}
              >
                <h3>
                  Payment Summary
                </h3>

                <div
                  style={{
                    display:
                      "flex",
                    justifyContent:
                      "space-between",
                    marginBottom:
                      "8px",
                  }}
                >
                  <span>
                    Ticket Subtotal
                  </span>

                  <strong>
                    {formatCurrency(
                      selectedBooking.ticketSubtotal
                    )}
                  </strong>
                </div>

                <div
                  style={{
                    display:
                      "flex",
                    justifyContent:
                      "space-between",
                    marginBottom:
                      "8px",
                  }}
                >
                  <span>
                    Food Subtotal
                  </span>

                  <strong>
                    {formatCurrency(
                      selectedBooking.foodSubtotal
                    )}
                  </strong>
                </div>

                {Number(
                  selectedBooking.discountAmount ||
                    0
                ) > 0 && (
                  <div
                    style={{
                      display:
                        "flex",
                      justifyContent:
                        "space-between",
                      marginBottom:
                        "8px",
                      color:
                        "#16a34a",
                    }}
                  >
                    <span>
                      Discount
                      {selectedBooking.couponCode
                        ? ` (${selectedBooking.couponCode})`
                        : ""}
                    </span>

                    <strong>
                      -
                      {formatCurrency(
                        selectedBooking.discountAmount
                      )}
                    </strong>
                  </div>
                )}

                <hr
                  style={{
                    border: "none",
                    borderTop:
                      "1px solid #e2e8f0",
                    margin:
                      "14px 0",
                  }}
                />

                <div
                  style={{
                    display:
                      "flex",
                    justifyContent:
                      "space-between",
                    fontSize:
                      "18px",
                  }}
                >
                  <strong>
                    Total
                  </strong>

                  <strong
                    style={{
                      color:
                        "#2563eb",
                    }}
                  >
                    {formatCurrency(
                      selectedBooking.totalAmount
                    )}
                  </strong>
                </div>

                <div
                  style={{
                    marginTop:
                      "15px",
                    fontSize:
                      "14px",
                    color:
                      "#64748b",
                  }}
                >
                  Ticket:{" "}
                  {
                    selectedBooking.ticketNumber ||
                    "Not generated"
                  }
                </div>

                <div
                  style={{
                    fontSize:
                      "14px",
                    color:
                      "#64748b",
                  }}
                >
                  Status:{" "}
                  {
                    selectedBooking.bookingStatus
                  }
                </div>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}

export default OrganizerDashboard;